# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration
DATABASE_URL=postgresql://fraud_user:fraud_password_secure_123@postgres:5432/fraud_detection

# Redis Configuration
REDIS_URL=redis://redis:6379

# MCP Server URLs (for internal communication)
MCP_DATA_INTELLIGENCE_URL=http://data-intelligence-server:8001
MCP_MODEL_ORCHESTRATION_URL=http://model-orchestration-server:8002  
MCP_DECISION_ENGINE_URL=http://decision-engine-server:8003
MCP_MONITORING_URL=http://monitoring-server:8004

# System Configuration
PYTHONPATH=/app/src
LOG_LEVEL=INFO
DEBUG=false

# Performance Settings
MAX_CONCURRENT_TRANSACTIONS=1000
PROCESSING_TIMEOUT_SECONDS=30
TARGET_LATENCY_MS=100

# Security Settings (change in production)
JWT_SECRET_KEY=your_jwt_secret_key_here
ENCRYPTION_KEY=your_encryption_key_here

# Monitoring Settings
GRAFANA_ADMIN_PASSWORD=admin123
PROMETHEUS_RETENTION_DAYS=30